# Copy values into environment.env. Never commit that file.
# OPENAI_API_KEY=your_openai_api_key
# api_key=your_openai_api_key
# PostgreSQL connection string for trusted sources, accounts, and sessions.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fact_check
# Set to true for managed PostgreSQL providers that require TLS.
# DATABASE_SSL=false
# TLS certificates are verified by default. Set false only when your provider explicitly requires it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Required for the separate administrator area. These credentials are never exposed to visitors.
# ADMIN_USER=admin
# ADMIN_PASSWORD=choose-a-long-unique-password
# Optional: defaults to gpt-5.6.
# OPENAI_MODEL=gpt-5.6
# PORT=3000
